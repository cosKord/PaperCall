generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  name      String   @id @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("branches")
}

model User {
  id                    Int            @id @default(autoincrement())
  email                 String         @unique @db.VarChar(254)
  supabaseUserId        String?        @unique @map("supabase_user_id") @db.Uuid
  username              String?        @unique @db.VarChar(120)
  branch                String?        @db.VarChar(80)
  role                  String         @default("player") @db.VarChar(20)
  active                Boolean        @default(true)
  totpSecret            String?        @map("totp_secret") @db.VarChar(64)
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  welcomeGrantClaimedAt DateTime?      @map("welcome_grant_claimed_at") @db.Timestamptz(3)
  profile               ProfileDetail?
  sessions              Session[]
  bugReports            BugReport[]
  bets                  Bet[]
  ledgerEntries         Ledger[]
  grantClaims           GrantClaim[]
  auditEntries          AuditLog[]     @relation("AuditActor")

  @@map("users")
}

model ProfileDetail {
  userId       Int      @id @map("user_id")
  fullName     String?  @map("full_name") @db.VarChar(120)
  academicYear String?  @map("academic_year") @db.VarChar(30)
  avatarPath   String?  @map("avatar_path")
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profile_details")
}

model BugReport {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  message   String
  status    String   @default("open") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("bug_reports")
}

model Session {
  tokenHash     String   @id @map("token_hash") @db.VarChar(64)
  userId        Int      @map("user_id")
  expiresAt     DateTime @map("expires_at") @db.Timestamptz(3)
  adminVerified Boolean  @default(false) @map("admin_verified")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model LoginCode {
  email      String   @id @db.VarChar(254)
  codeHash   String   @map("code_hash") @db.VarChar(64)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  attempts   Int      @default(0)
  lastSentAt DateTime @map("last_sent_at") @db.Timestamptz(3)

  @@map("login_codes")
}

model Market {
  id                Int                @id @default(autoincrement())
  subject           String             @db.VarChar(120)
  examType          String             @map("exam_type") @db.VarChar(20)
  startsAt          DateTime           @map("starts_at") @db.Timestamptz(3)
  endsAt            DateTime?          @map("ends_at") @db.Timestamptz(3)
  lockoutAt         DateTime           @map("lockout_at") @db.Timestamptz(3)
  grantPts          Int                @map("grant_pts")
  homeBranches      Json               @map("home_branches")
  minStake          Int                @default(1) @map("min_stake")
  awayMinStake      Int                @default(10) @map("away_min_stake")
  lowCapPct         Int                @default(20) @map("low_cap_pct")
  highCapPct        Int                @default(40) @map("high_cap_pct")
  status            String             @db.VarChar(20)
  paperPath         String?            @map("paper_path")
  paperHash         String?            @map("paper_hash") @db.VarChar(64)
  settledAt         DateTime?          @map("settled_at") @db.Timestamptz(3)
  legacy            Boolean            @default(false)
  reviewNeeded      Boolean            @default(false) @map("review_needed")
  branchExams       BranchExam[]
  topics            Topic[]
  ledgerEntries     Ledger[]
  grantClaims       GrantClaim[]
  settlementPreview SettlementPreview?

  @@map("markets")
}

model BranchExam {
  id       Int      @id @default(autoincrement())
  marketId Int      @map("market_id")
  branch   String   @db.VarChar(80)
  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  market   Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([marketId, branch])
  @@map("branch_exams")
}

model Topic {
  id       Int     @id @default(autoincrement())
  marketId Int     @map("market_id")
  title    String  @db.VarChar(240)
  tier     String  @db.VarChar(10)
  outcome  String? @db.VarChar(10)
  market   Market  @relation(fields: [marketId], references: [id], onDelete: Cascade)
  bets     Bet[]

  @@map("topics")
}

model Bet {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  topicId   Int      @map("topic_id")
  side      String   @db.VarChar(10)
  stake     Int
  payout    Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Restrict)
  ledger    Ledger[]

  @@unique([userId, topicId])
  @@map("bets")
}

model Ledger {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  marketId  Int?     @map("market_id")
  betId     Int?     @map("bet_id")
  amount    Int
  reason    String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  market    Market?  @relation(fields: [marketId], references: [id], onDelete: Restrict)
  bet       Bet?     @relation(fields: [betId], references: [id], onDelete: Restrict)

  @@map("ledger")
}

model GrantClaim {
  userId   Int    @map("user_id")
  marketId Int    @map("market_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  market   Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@id([userId, marketId])
  @@map("grant_claims")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int?     @map("actor_id")
  action    String   @db.VarChar(80)
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@map("audit_log")
}

model SettlementPreview {
  marketId  Int      @id @map("market_id")
  digest    String   @db.VarChar(64)
  outcomes  Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  market    Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@map("settlement_previews")
}
