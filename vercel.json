{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend/",
      "framework": "fastify",
      "entrypoint": "src/server.js"
    },
    "backend_probe": {
      "root": "backend-probe/",
      "framework": "fastify",
      "entrypoint": "src/server.js"
    },
    "frontend": {
      "root": "frontend/",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/api-diagnostic/(.*)",
      "destination": {
        "service": "backend_probe"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
